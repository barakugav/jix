# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# LLVM source-based coverage profile data
*.profraw

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Byte-compiled / optimized / DLL files
__pycache__/
.pytest_cache/
*.py[cod]

# Local benchmark run output (see scripts/bench/run.py)
scripts/bench/.results/


jix/Cargo.lock
jix-macros/Cargo.lock

# Bug-hunt scratch: per-run integration tests (the report stage moves repros into
# bug-hunt/runs/<run>/repros/) and hunter scratch scripts. See bug-hunt/README.md.
jix/tests/hunt_*.rs
jix/tests/repro_*.rs
bug-hunt/runs/*/scratch/
