#!/usr/bin/env bash
# C compiler for i686-unknown-linux-musl via zig (installed into .venv by setup.sh --i686); used by
# cc-rs to build zstd-sys. Linking is done by clang + lld (see cargo-i686).
# Drops the --target flag cc-rs/rustc pass (zig wants its own spelling) and adds zig's.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
args=()
for a in "$@"; do
    case "$a" in
        --target=*|-target|-m32|-Wl,-melf_i386) ;;
        *) args+=("$a") ;;
    esac
done
exec "$ROOT/.venv/bin/python" -m ziglang cc -target x86-linux-musl "${args[@]}"
